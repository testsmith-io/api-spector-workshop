    "19e29fe7-da56-4695-87aa-a6ffb46cdf2d": {
      "id": "19e29fe7-da56-4695-87aa-a6ffb46cdf2d",
      "name": "Register (use faker)",
      "method": "GET",
      "url": "",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "none",
        "json": "",
        "raw": ""
      },
      "description": "Perform a `POST` request on the `users/register` endpoint of practicesoftwaretesting.com\n\nUse the built-in faker implementation to generate data, like: name, email, address\n\nUse the following pre-request script to generate a Date Of Birth that can be used in the body:\n\n\n```\nconst dob = faker.date.birthdate({ min: 18, max: 70, mode: 'age' });\nsp.variables.set('dob', dayjs(dob).format('YYYY-MM-DD'));\n```\n\n\n\nSwagger: https://api.practicesoftwaretesting.com/api/documentation\n\n\n",
      "preRequestScript": ""
    },
    "ba634e3c-c208-4b06-9251-b2f8b04218d9": {
      "id": "ba634e3c-c208-4b06-9251-b2f8b04218d9",
      "name": "SOAP service",
